# Copie este arquivo para .env.local e ajuste.

# Caminho do banco SQLite. Backup = copiar este arquivo.
CSYSTEM_DB_PATH=./data/csystem.db

# Segredo do webhook do SDR. O n8n envia no header: x-csystem-token
# Gere um valor longo e aleatório. NUNCA comite o .env.local.
CSYSTEM_WEBHOOK_TOKEN=troque-este-valor-por-um-segredo-longo

# URL pública do app, usada para montar o link que o n8n manda no WhatsApp do Alex.
CSYSTEM_PUBLIC_URL=http://localhost:3000
